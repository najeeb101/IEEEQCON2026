---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { logoGroups, logoFile, brandColors, brandFonts, logoDos, logoDonts } from '../../data/brand';
import { site, fullName } from '../../config/site';
import { url } from '../../lib/url';

const kb = (bytes: number) => `${Math.round(bytes / 1024)} KB`;
const mail = `mailto:${site.contact.email}?subject=${encodeURIComponent(`${fullName} logo files`)}`;
---

<PageLayout
  title="Media Kit"
  lead={`Official ${fullName} logos and colors for sponsors, partners, press and volunteers.`}
  crumbs={[{ label: 'About', href: '/about/' }, { label: 'Media Kit' }]}
>
  <Fragment slot="actions">
    <Button href="#logos" icon="download">Download logos</Button>
    <Button href="#usage" variant="outline">How to use them</Button>
  </Fragment>

  <section class="section" id="logos" aria-labelledby="logos-title">
    <div class="container">
      <SectionHeading
        id="logos-title"
        eyebrow="Download"
        title="Logos"
        lead="High-resolution PNG files with transparent backgrounds. Pick the version made for your background."
      />

      {
        logoGroups.map((group) => (
          <div class="kit-group">
            <div class="kit-group__head" data-reveal>
              <h3 class="smallcaps">{group.title}</h3>
              <p class="muted">{group.body}</p>
            </div>
            <ul class:list={['kit', { 'kit--icons': group.title === 'Icon' }]} role="list" data-reveal>
              {group.items.map((item) => {
                const file = logoFile(item.id);
                return (
                  <li class="kit__item">
                    <div class:list={['kit__preview', `kit__preview--${item.surface}`]}>
                      <img
                        src={url(file.preview.src)}
                        alt={`${fullName} ${group.title.toLowerCase()}, ${item.title.toLowerCase()}`}
                        width={file.preview.width}
                        height={file.preview.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="kit__body">
                      <h4>{item.title}</h4>
                      <p class="kit__use">{item.use}</p>
                      <p class="kit__meta">
                        PNG · {file.width} × {file.height} · {kb(file.bytes)}
                      </p>
                      <Button
                        href={file.src}
                        variant="outline"
                        size="sm"
                        iconStart="download"
                        download={`ieee-qcon-${site.edition}-${item.id}.png`}
                        aria-label={`Download ${group.title.toLowerCase()}, ${item.title.toLowerCase()} (PNG)`}
                      >
                        Download
                      </Button>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }

      <p class="kit-note" data-reveal>
        <Icon name="mail" size={18} />
        <span>
          Need a vector or print-ready file? <a href={mail}>Email {site.contact.email}</a>
        </span>
      </p>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="colors-title">
    <div class="container">
      <SectionHeading id="colors-title" eyebrow="Brand" title="Colors & Type" lead="The logo’s blue and maroon, plus the colors and fonts of this website." />

      <ul class="swatches" role="list" data-reveal>
        {
          brandColors.map((c) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${c.token})`} aria-hidden="true" />
              <div class="swatch__body">
                <h3>{c.name}</h3>
                <button class="swatch__hex" type="button" data-copy={c.hex} aria-label={`Copy ${c.name} ${c.hex}`}>
                  <span data-copy-label>{c.hex}</span>
                  <Icon name="check" size={16} class="swatch__done" />
                </button>
                <p class="swatch__use">{c.use}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <ul class="fonts" role="list" data-reveal>
        {
          brandFonts.map((f) => (
            <li class="font">
              <p class="font__sample" style={`font-family: ${f.family}`} aria-hidden="true">
                Aa
              </p>
              <div>
                <h3>{f.name}</h3>
                <p class="swatch__use">{f.use} · free on Google Fonts</p>
                <Button href={f.url} variant="ghost" size="sm">
                  Get {f.name}
                </Button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="usage" aria-labelledby="usage-title">
    <div class="container">
      <SectionHeading id="usage-title" eyebrow="Guidelines" title="Using the logo" />
      <div class="rules" data-reveal>
        <div class="rules__col rules__col--do">
          <h3 class="smallcaps">Do</h3>
          <ul role="list">
            {
              logoDos.map((rule) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{rule}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rules__col rules__col--dont">
          <h3 class="smallcaps">Don’t</h3>
          <ul role="list">
            {
              logoDonts.map((rule) => (
                <li>
                  <Icon name="close" size={18} />
                  <span>{rule}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .kit-group + .kit-group {
    margin-top: var(--space-8);
  }

  .kit-group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
  }

  .kit-group__head h3 {
    font-size: var(--text-xl);
  }

  .kit {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kit__item {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--dur),
      translate var(--dur) var(--ease-out);
  }

  .kit__item:hover {
    border-color: var(--line);
    translate: 0 -3px;
  }

  .kit__preview {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .kit__preview--dark {
    background:
      radial-gradient(70% 80% at 50% 110%, color-mix(in srgb, var(--brand-maroon) 35%, transparent), transparent 70%),
      var(--bg-deep);
    border-bottom: 1px solid var(--line-soft);
  }

  .kit__preview--light {
    background: var(--paper);
  }

  /* The tile sets the size, so tall icons and wide logos both fit inside the padding. */
  .kit__preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: var(--space-6);
    object-fit: contain;
  }

  .kit--icons .kit__preview img {
    padding-block: var(--space-5);
  }

  .kit__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-1);
    padding: var(--space-5);
  }

  .kit__body h4 {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .kit__use {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .kit__meta {
    margin-bottom: var(--space-3);
    color: var(--text-subtle);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .kit-note {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    color: var(--text-muted);
  }

  .kit-note :global(svg) {
    color: var(--accent-soft);
  }

  .kit-note a {
    color: var(--accent-soft);
    font-weight: 500;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatch {
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .swatch__chip {
    display: block;
    height: 120px;
    border-bottom: 1px solid var(--line-soft);
  }

  .swatch__body {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .swatch h3,
  .font h3 {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .swatch__hex {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 32px;
    padding: 0 0.6em;
    margin-left: -0.6em;
    border: 0;
    border-radius: var(--radius-xs);
    background: none;
    color: var(--accent-soft);
    font: inherit;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color var(--dur-fast);
  }

  .swatch__hex:hover {
    background: var(--surface-hover);
  }

  .swatch__hex :global(.swatch__done) {
    display: none;
  }

  .swatch__hex.is-copied :global(.swatch__done) {
    display: inline-block;
  }

  .swatch__use {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .fonts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .font {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .font__sample {
    flex: none;
    width: 96px;
    color: var(--text);
    font-size: 3.5rem;
    font-weight: 300;
    line-height: 1;
    text-align: center;
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .rules__col {
    padding: var(--space-6);
    border: 1px solid var(--line-soft);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .rules__col--dont {
    border-top-color: var(--accent-2);
  }

  .rules__col h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .rules ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules li {
    display: flex;
    gap: var(--space-3);
    color: var(--text-body);
  }

  .rules li :global(svg) {
    margin-top: 0.2em;
    color: var(--accent);
  }

  .rules__col--dont li :global(svg) {
    color: var(--accent-2);
  }

  @media (max-width: 960px) {
    .swatches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .fonts,
    .rules {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .swatch__chip {
      height: 88px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    const value = btn.dataset.copy!;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        return;
      }
      btn.classList.add('is-copied');
      label.textContent = 'Copied';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-copied');
        label.textContent = value;
      }, 1600);
    });
  });
</script>
