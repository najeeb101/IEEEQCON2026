---
import PageLayout from '../../layouts/PageLayout.astro';
import ScheduleList from '../../components/ui/ScheduleList.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { schedule, scheduleDate, scheduleStatus, pastEditions } from '../../data/program';
import { site, dateText, timeText } from '../../config/site';
import { dateParts } from '../../lib/format';

const weekday = scheduleDate ? dateParts(scheduleDate).weekday : 'One-day conference';
const basedOn = pastEditions[0];
---

<PageLayout
  title="Conference Schedule"
  lead={`A full day of keynotes, technical talks, posters, prototypes and networking at ${site.venue.name}.`}
  crumbs={[{ label: 'Program' }, { label: 'Schedule' }]}
>
  <section class="section">
    <div class="container container--narrow">
      <header class="dayhead" data-reveal>
        <p class="eyebrow">{weekday}</p>
        <h2 class="dayhead__date smallcaps">{dateText}</h2>
        <p class="dayhead__meta">
          <span><Icon name="clock" size={18} /> {timeText}</span>
          <span><Icon name="pin" size={18} /> {site.venue.name}</span>
        </p>
      </header>

      {
        scheduleStatus === 'tentative' && (
          <p class="tentative" data-reveal>
            <Icon name="info" size={18} />
            <span>
              <strong>Tentative program.</strong> This follows the {basedOn ? <span class="nowrap">Q-Con {basedOn.year}</span> : 'previous'} day
              plan, so you know what to expect. Final times and sessions will be announced.
            </span>
          </p>
        )
      }

      <ScheduleList items={schedule} />

      <p class="note">Times are in Doha time (GMT+3). Rooms and session details are added as they are confirmed.</p>

      <div class="actions" data-reveal>
        <Button href="/registration/" icon="arrow-right">Register</Button>
        <Button href="/program/speakers/" variant="outline">Meet the speakers</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .dayhead {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
    padding: var(--space-6);
    background: var(--surface);
    text-align: center;
  }

  .dayhead__date {
    color: #fff;
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  .dayhead__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    color: var(--text-muted);
  }

  .dayhead__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .dayhead__meta :global(svg) {
    color: var(--accent-soft);
  }

  .tentative {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--accent-2);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tentative :global(svg) {
    margin-top: 0.15em;
    color: var(--accent-2);
  }

  .tentative strong {
    color: var(--text);
  }

  /* Keep "Q-Con 2026" together; browsers may break after the hyphen. */
  .nowrap {
    white-space: nowrap;
  }

  .note {
    margin-top: var(--space-5);
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
</style>
