---
import PageLayout from '../../layouts/PageLayout.astro';
import SubmissionBlock from '../../components/ui/SubmissionBlock.astro';
import RequirementList from '../../components/ui/RequirementList.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import DateTimeline from '../../components/ui/DateTimeline.astro';
import Button from '../../components/ui/Button.astro';
import RulesNotice from '../../components/sections/RulesNotice.astro';
import { tracks, abstractRequirements, posterRequirements, posterTemplateUrl, formatDates } from '../../data/submissions';

const track = tracks.find((t) => t.id === 'poster')!;
---

<PageLayout
  title="Poster Competition"
  lead="Submit a one-page abstract and present your research as a poster. Posters are judged on conference day, with awards for undergraduate and graduate categories."
  crumbs={[{ label: 'Submissions', href: '/submissions/' }, { label: 'Poster Competition' }]}
>
  <section class="section">
    <div class="container">
      <RulesNotice />
      <SubmissionBlock
        title="Abstract Submission"
        status={track.status}
        formUrl={track.formUrl}
        deadline={track.deadline}
        deadlineLabel="Submission deadline"
      >
        <h3>Abstract requirements</h3>
        <RequirementList items={abstractRequirements} />
      </SubmissionBlock>

      <SubmissionBlock title="Poster Submission" status={track.status === 'open' ? 'soon' : track.status}>
        <h3>Poster requirements</h3>
        <RequirementList items={posterRequirements} />
        <div class="template">
          {
            posterTemplateUrl ? (
              <Button href={posterTemplateUrl} variant="outline" iconStart="download">
                Download the A1 poster template
              </Button>
            ) : (
              <p class="muted">The link to the official A1 poster template will be posted here.</p>
            )
          }
        </div>
      </SubmissionBlock>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container container--narrow">
      <SectionHeading title="Important Dates" eyebrow="Poster Competition" align="center" />
      <DateTimeline dates={formatDates} showTrack={false} />
    </div>
  </section>
</PageLayout>

<style>
  .template {
    margin-top: var(--space-5);
  }
</style>
