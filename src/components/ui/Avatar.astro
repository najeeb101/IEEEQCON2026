---
/** Circular portrait (IECON committee/speaker style) with a brand-gradient ring and an initials fallback. */
import Icon from './Icon.astro';
import { initials } from '../../lib/format';
import { url } from '../../lib/url';

interface Props {
  name: string;
  photo?: string;
  size?: number;
  /** Shows a neutral silhouette instead of initials. */
  placeholder?: boolean;
}

const { name, photo, size = 160, placeholder = false } = Astro.props;
const letters = placeholder ? '' : initials(name);
---

<span class="avatar" style={`--size:${size}px`}>
  {
    photo ? (
      <img src={url(photo)} alt="" width={size} height={size} loading="lazy" decoding="async" />
    ) : letters ? (
      <span class="avatar__initials" aria-hidden="true">{letters}</span>
    ) : (
      <span class="avatar__placeholder"><Icon name="user" size={Math.round(size * 0.36)} /></span>
    )
  }
</span>

<style>
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-brand);
    box-shadow: 0 18px 40px -18px rgb(57 148 200 / 0.5);
  }

  .avatar > * {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  img {
    object-fit: cover;
    background: var(--surface);
  }

  .avatar__initials {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 25%, rgb(57 148 200 / 0.35), transparent 60%),
      var(--surface);
    font-family: var(--font-display);
    font-size: calc(var(--size) * 0.3);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--blue-100);
  }

  .avatar__placeholder {
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--ink-400);
  }
</style>
