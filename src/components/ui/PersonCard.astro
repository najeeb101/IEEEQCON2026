---
/**
 * Speaker / committee card — IECON's circular portrait grid in Q-Con colors.
 * With a `bio`, a "Read more" button opens a modal dialog (IECON keynote pattern).
 */
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';

interface Props {
  name: string;
  role?: string;
  affiliation?: string;
  session?: string;
  bio?: string;
  photo?: string;
  tba?: boolean;
  size?: 'md' | 'lg';
  index?: number;
}

const { name, role, affiliation, session, bio, photo, tba = false, size = 'lg', index = 0 } = Astro.props;
const displayName = tba || !name ? 'To be announced' : name;
const dialogId = bio ? `bio-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
const avatarSize = size === 'lg' ? 168 : 128;
---

<article class:list={['person', `person--${size}`, { 'person--tba': tba || !name }]} data-reveal style={`--reveal-delay:${index}`}>
  <Avatar name={displayName} photo={photo} size={avatarSize} placeholder={tba || !name} />
  <div class="person__text">
    {session && <span class="person__slot">{session}</span>}
    <h3 class="person__name">{displayName}</h3>
    {role && <p class="person__role">{role}</p>}
    {affiliation && <p class="person__affiliation">{affiliation}</p>}
  </div>
  {
    bio && (
      <>
        <button class="person__more" type="button" data-dialog-open={dialogId}>
          Read more <Icon name="arrow-right" size={16} />
        </button>
        <dialog class="person__dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
          <div class="person__dialog-inner">
            <button class="person__close" type="button" data-dialog-close aria-label="Close">
              <Icon name="close" size={22} />
            </button>
            <Avatar name={displayName} photo={photo} size={120} />
            <div>
              {session && <span class="person__slot">{session}</span>}
              <h2 id={`${dialogId}-title`}>{displayName}</h2>
              {affiliation && <p class="person__affiliation">{affiliation}</p>}
              <p class="person__bio">{bio}</p>
            </div>
          </div>
        </dialog>
      </>
    )
  }
</article>

<style>
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .person__text {
    display: grid;
    gap: 0.2em;
  }

  .person__slot {
    display: block;
    margin-bottom: 0.35em;
    color: var(--accent-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .person__name {
    color: var(--accent-soft);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .person--md .person__name {
    font-size: var(--text-lg);
  }

  .person--tba .person__name {
    color: var(--text-muted);
    font-weight: 400;
  }

  .person__role {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .person__affiliation {
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }

  .person__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 40px;
    padding: 0 1.1em;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: none;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--dur-fast), background-color var(--dur-fast);
  }

  .person__more:hover {
    border-color: var(--accent);
    background: rgb(57 148 200 / 0.1);
  }

  .person__dialog {
    width: min(640px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text-body);
    box-shadow: var(--shadow-pop);
    text-align: left;
  }

  .person__dialog::backdrop {
    background: rgb(8 8 10 / 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .person__dialog-inner {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-6);
    padding: var(--space-7) var(--space-6) var(--space-6);
  }

  .person__dialog h2 {
    font-size: var(--text-2xl);
  }

  .person__bio {
    margin-top: var(--space-4);
    color: var(--text-muted);
  }

  .person__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }

  .person__close:hover {
    background: var(--surface-hover);
    color: #fff;
  }

  @media (max-width: 560px) {
    .person__dialog-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.dialogOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    // Close when the backdrop is clicked.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
