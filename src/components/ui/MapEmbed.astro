---
/**
 * Venue map. By default it shows a lightweight placeholder and loads the Google Maps embed only
 * when the visitor asks for it: the embed runs seconds of script on phones, and Google sees no
 * visit until the map is opened. `autoload` loads it on its own once the page has finished
 * loading, for pages where the map is the point (Venue): the embed is ~450 KB, so it waits
 * rather than delaying the first paint. "Directions" works immediately either way.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, mapsEmbedUrl, mapsDirectionsUrl } from '../../config/site';

interface Props {
  height?: string;
  /** Load the Google Maps embed by itself after the page loads, instead of on request. */
  autoload?: boolean;
}

const { height = 'clamp(320px, 45vw, 460px)', autoload = false } = Astro.props;
const title = `Map showing ${site.venue.name}`;
---

<div class="map" style={`--map-h:${height}`}>
  <div class="map__frame" data-map data-src={mapsEmbedUrl} data-title={title} data-autoload={autoload || undefined}>
    <div class="map__placeholder" aria-hidden="true">
      <span class="map__ping">
        <Icon name="pin" size={30} />
      </span>
    </div>
    {
      !autoload && (
        <div class="map__load">
          <button type="button" data-map-load>
            <Icon name="globe" size={18} />
            Show interactive map
          </button>
          <span>Loads Google Maps</span>
        </div>
      )
    }
  </div>
  <div class="map__card">
    <span class="map__pin"><Icon name="pin" size={22} /></span>
    <div>
      <strong>{site.venue.name}</strong>
      <span>{site.venue.area}, {site.venue.city}, {site.venue.country}</span>
    </div>
    <Button href={mapsDirectionsUrl} size="sm" icon="external">Directions</Button>
  </div>
</div>

<style>
  .map {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .map__frame {
    position: relative;
    height: var(--map-h);
  }

  .map__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.25) invert(0.9) hue-rotate(180deg) contrast(0.92) brightness(0.95);
  }

  /* A quiet street-grid look in theme colors. */
  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(40% 55% at 50% 45%, rgb(57 148 200 / 0.16), transparent 70%),
      repeating-linear-gradient(0deg, var(--line-soft) 0 1px, transparent 1px 56px),
      repeating-linear-gradient(90deg, var(--line-soft) 0 1px, transparent 1px 56px),
      linear-gradient(32deg, transparent 48.6%, rgb(255 255 255 / 0.07) 49%, rgb(255 255 255 / 0.07) 51%, transparent 51.4%),
      var(--bg-deep);
  }

  .map__ping {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 90px;
    border-radius: 50%;
    background: rgb(190 74 74 / 0.18);
    color: var(--maroon-300);
  }

  .map__ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(229 138 138 / 0.6);
    border-radius: 50%;
    animation: ping 2.4s var(--ease-out) infinite;
  }

  @keyframes ping {
    to {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  .map__load {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    transform: translate(-50%, 10px);
    color: var(--text-subtle);
    font-size: var(--text-xs);
  }

  .map__load button {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    padding: 0 1.2em;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgb(27 28 30 / 0.92);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast);
  }

  .map__load button:hover {
    border-color: var(--accent);
    background: rgb(57 148 200 / 0.14);
  }

  .map__card {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    max-width: calc(100% - 2rem);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgb(20 20 22 / 0.94);
    box-shadow: var(--shadow-pop);
  }

  .map__card > div {
    display: grid;
    line-height: 1.35;
  }

  .map__card strong {
    font-family: var(--font-display);
    font-weight: 500;
  }

  .map__card span {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .map__card .map__pin {
    display: grid;
    color: var(--accent-2);
  }

  .map__load button {
    white-space: nowrap;
  }

  /* On phones the venue card sits under the map instead of covering it. */
  @media (max-width: 560px) {
    .map__card {
      position: static;
      max-width: none;
      border-width: 1px 0 0;
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>

<script>
  const load = (root: HTMLElement) => {
    const frame = document.createElement('iframe');
    frame.src = root.dataset.src!;
    frame.title = root.dataset.title!;
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.allowFullscreen = true;
    root.replaceChildren(frame);
    return frame;
  };

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    root.querySelector('[data-map-load]')?.addEventListener('click', () => load(root).focus());
    if (root.dataset.autoload === undefined) return;
    // Wait for the page's own load, so the map doesn't hold up the first paint.
    if (document.readyState === 'complete') load(root);
    else window.addEventListener('load', () => load(root), { once: true });
  });
</script>
