---
/**
 * Important-dates timeline (IECON's list, Q-Con's calendar badges).
 * Past dates dim and get a check; the next upcoming date is highlighted — computed in the
 * visitor's browser so it stays correct without a rebuild.
 */
import Icon from './Icon.astro';
import type { ImportantDate } from '../../data/submissions';
import { dateParts, formatDate } from '../../lib/format';

interface Props {
  dates: ImportantDate[];
  showTrack?: boolean;
  class?: string;
}

const { dates, showTrack = true, class: className } = Astro.props;
---

<ol class:list={['timeline', className]} role="list" data-timeline data-reveal>
  {
    dates.map((d) => {
      const parts = d.date ? dateParts(d.date) : null;
      return (
        <li
          class:list={['timeline__item', { 'is-milestone': d.milestone, 'is-tbd': !d.date }]}
          data-date={d.date ?? undefined}
        >
          <span class="timeline__badge" aria-hidden="true">
            {parts ? (
              <>
                <span class="timeline__month">{parts.month}</span>
                <span class="timeline__day">{parts.day}</span>
              </>
            ) : (
              <span class="timeline__tbd">TBA</span>
            )}
          </span>
          <div class="timeline__text">
            <span class="timeline__label">{d.label}</span>
            <span class="timeline__meta">
              {d.date ? <time datetime={d.date}>{formatDate(d.date)}</time> : <span>{formatDate(null)}</span>}
              {showTrack && d.track && <span class="timeline__track">{d.track}</span>}
            </span>
          </div>
          <span class="timeline__state">
            <span class="timeline__next">Next</span>
            <span class="timeline__check"><Icon name="check" size={18} label="Passed" /></span>
          </span>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition:
      border-color var(--dur),
      opacity var(--dur);
  }

  .timeline__badge {
    display: grid;
    place-items: center;
    align-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    line-height: 1;
  }

  .timeline__month {
    color: var(--accent-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .timeline__day {
    margin-top: 4px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
  }

  .timeline__tbd {
    color: var(--text-subtle);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .timeline__label {
    display: block;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .timeline__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25em 0.9em;
    margin-top: 0.25em;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .timeline__track {
    color: var(--text-subtle);
  }

  .timeline__track::before {
    content: '·';
    margin-right: 0.9em;
  }

  .timeline__state > * {
    display: none;
  }

  .timeline__next {
    padding: 0.25em 0.8em;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline__check {
    color: var(--text-subtle);
  }

  /* States (set by script) */
  .timeline__item.is-past {
    opacity: 0.55;
  }

  .timeline__item.is-past .timeline__check {
    display: block;
  }

  .timeline__item.is-next {
    border-color: rgb(57 148 200 / 0.6);
    box-shadow: var(--glow-accent);
  }

  .timeline__item.is-next .timeline__next {
    display: inline-block;
  }

  .timeline__item.is-milestone {
    border-color: transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      var(--gradient-brand) border-box;
  }

  .timeline__item.is-milestone .timeline__badge {
    border-color: transparent;
    background: var(--gradient-brand);
  }

  .timeline__item.is-milestone .timeline__month,
  .timeline__item.is-milestone .timeline__day,
  .timeline__item.is-milestone .timeline__tbd {
    color: #fff;
  }

  @media (max-width: 520px) {
    .timeline__item {
      grid-template-columns: auto 1fr;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .timeline__state {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
    }

    .timeline__badge {
      width: 56px;
      height: 56px;
    }

    .timeline__text {
      padding-right: var(--space-5);
    }

    .timeline__meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .timeline__track::before {
      display: none;
    }
  }
</style>

<script>
  // End of each date in Doha time decides "past"; the first future-dated item becomes "next".
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((list) => {
    const now = Date.now();
    let nextMarked = false;
    list.querySelectorAll<HTMLElement>('[data-date]').forEach((item) => {
      const end = new Date(`${item.dataset.date}T23:59:59+03:00`).getTime();
      if (end < now) item.classList.add('is-past');
      else if (!nextMarked) {
        item.classList.add('is-next');
        nextMarked = true;
      }
    });
  });
</script>
