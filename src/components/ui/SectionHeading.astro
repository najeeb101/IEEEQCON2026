---
/**
 * Section heading — IECON's eyebrow + title + accent bar, set in Q-Con type.
 * The bar uses the brand gradient (IEEE blue → maroon).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  size?: 'md' | 'lg';
  bar?: boolean;
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, align = 'start', as: Tag = 'h2', size = 'md', bar = true, id, class: className } = Astro.props;
---

<header class:list={['heading', `heading--${align}`, `heading--${size}`, className]} data-reveal>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag id={id} class="heading__title">{title}</Tag>
  {bar && <span class="heading__bar" aria-hidden="true"></span>}
  {lead && <p class="heading__lead lead">{lead}</p>}
  <slot />
</header>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 760px;
    margin-bottom: var(--space-7);
  }

  .heading--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .heading__title {
    font-size: var(--text-3xl);
    font-weight: 500;
  }

  .heading--lg .heading__title {
    font-size: var(--text-4xl);
  }

  .heading__bar {
    width: 72px;
    height: 3px;
    margin-top: var(--space-1);
    border-radius: 2px;
    background: var(--gradient-brand);
  }

  .heading__lead {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  :global(.section--paper) .heading__lead {
    color: #5b616b;
  }

  :global(.section--paper) .eyebrow {
    color: var(--brand-blue);
  }
</style>
