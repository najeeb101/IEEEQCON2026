---
/**
 * Q-Con submissions row: a hairline table with the action/status on the left
 * (big "Submit now" or "Opening soon", deadline beneath) and the requirements on the right.
 */
import Button from './Button.astro';
import StatusBadge from './StatusBadge.astro';
import type { Status } from '../../config/site';
import { formatDate } from '../../lib/format';

interface Props {
  title: string;
  status: Status;
  formUrl?: string;
  deadline?: string | null;
  deadlineLabel?: string;
  actionLabel?: string;
}

const { title, status, formUrl, deadline, deadlineLabel = 'Deadline', actionLabel = 'Submit now' } = Astro.props;
const canSubmit = status === 'open' && !!formUrl;
---

<div class="block" data-reveal>
  <div class="block__action">
    {canSubmit ? <Button href={formUrl} size="lg">{actionLabel}</Button> : <StatusBadge status={status} />}
    {
      deadline !== undefined && (
        <p class="block__deadline">
          <span>{deadlineLabel}</span>
          <strong>{formatDate(deadline ?? null)}</strong>
        </p>
      )
    }
  </div>
  <div class="block__body">
    <h2>{title}</h2>
    <slot />
  </div>
</div>

<style>
  .block {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 3fr;
    border: 1px solid var(--line);
    background: rgb(20 20 22 / 0.6);
  }

  .block + :global(.block) {
    border-top: 0;
  }

  .block__action {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-5);
    border-right: 1px solid var(--line);
    text-align: center;
  }

  .block__deadline {
    display: grid;
    gap: 2px;
    font-size: var(--text-sm);
  }

  .block__deadline span {
    color: var(--text-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .block__deadline strong {
    color: var(--maroon-300);
    font-weight: 500;
    font-size: var(--text-base);
  }

  .block__body {
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }

  .block__body h2 {
    margin-bottom: var(--space-5);
    font-size: var(--text-2xl);
  }

  .block__body :global(h3) {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--accent-soft);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .block__body :global(h3:first-of-type) {
    margin-top: 0;
  }

  @media (max-width: 760px) {
    .block {
      grid-template-columns: 1fr;
    }

    .block__action {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-block: var(--space-6);
    }
  }
</style>
