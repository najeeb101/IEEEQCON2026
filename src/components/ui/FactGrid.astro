---
/** Row of icon + label + value facts (date, time, venue…). */
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { url } from '../../lib/url';

interface Fact {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts" data-reveal>
  {
    facts.map((f) => (
      <div class="fact">
        <span class="fact__icon">
          <Icon name={f.icon} size={22} />
        </span>
        <div>
          <dt>{f.label}</dt>
          <dd>{f.href ? <a href={url(f.href)}>{f.value}</a> : f.value}</dd>
        </div>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .fact {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .fact__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: rgb(57 148 200 / 0.1);
    color: var(--accent);
  }

  dt {
    color: var(--text-subtle);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.2em 0 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  dd a {
    color: inherit;
    text-decoration: none;
  }

  dd a:hover {
    color: var(--accent-soft);
  }
</style>
