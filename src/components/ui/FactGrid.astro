---
/** Row of icon + label + value facts (date, time, venue…). */
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { url } from '../../lib/url';

interface Fact {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts" data-reveal>
  {
    facts.map((f) => (
      <div class="fact">
        <dt>
          <span class="fact__icon">
            <Icon name={f.icon} size={22} />
          </span>
          {f.label}
        </dt>
        <dd>{f.href ? <a href={url(f.href)}>{f.value}</a> : f.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  /* A <dl> group may hold only <dt> and <dd>, so the icon lives in the <dt> and is placed in the left gutter. */
  .fact {
    --icon: 46px;
    position: relative;
    min-height: calc(var(--icon) + 2 * var(--space-5));
    padding: var(--space-5);
    padding-left: calc(var(--space-5) + var(--icon) + var(--space-4));
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .fact__icon {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    display: grid;
    place-items: center;
    width: var(--icon);
    height: var(--icon);
    border-radius: var(--radius-sm);
    background: rgb(57 148 200 / 0.1);
    color: var(--accent);
  }

  dt {
    color: var(--text-subtle);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.2em 0 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.35;
    /* Long unbroken values (the email address) wrap instead of spilling out of the box. */
    overflow-wrap: anywhere;
  }

  dd a {
    color: inherit;
    text-decoration: none;
  }

  dd a:hover {
    color: var(--accent-soft);
  }
</style>
