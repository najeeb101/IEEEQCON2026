---
import Icon from '../ui/Icon.astro';
---

<button class="to-top" type="button" data-to-top aria-label="Back to top">
  <Icon name="arrow-up" size={20} />
</button>

<style>
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: calc(var(--z-header) - 1);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(27 28 30 / 0.94);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur),
      border-color var(--dur-fast);
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .to-top:hover {
    border-color: var(--accent);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (btn) {
    const update = () => btn.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.9);
    update();
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0 });
      document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
    });
  }
</script>
