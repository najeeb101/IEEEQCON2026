---
/**
 * Site header — Q-Con layout (logo left, links right, outlined Register button)
 * with IECON's dropdown sub-menus. Transparent over the hero, solid once scrolled.
 * Below 1080px it collapses to a full-screen menu with native <details> accordions.
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { mainNav, navCta } from '../../config/navigation';
import { site, fullName } from '../../config/site';
import { url, isActive } from '../../lib/url';

const path = Astro.url.pathname;
const desktopNav = mainNav.filter((item) => !item.mobileOnly);
const sectionActive = (item: (typeof mainNav)[number]) =>
  item.children ? item.children.some((c) => isActive(path, c.href, true)) : isActive(path, item.href, item.href !== '/');
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-label={`${fullName} home`}>
      <img src={url('/brand/qcon-logo-white.png')} alt="" width="362" height="193" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list" role="list">
        {
          desktopNav.map((item, i) =>
            item.children ? (
              <li class="nav__item nav__item--menu" data-dropdown>
                <button
                  class:list={['nav__link', { 'is-active': sectionActive(item) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-menu-${i}`}
                >
                  {item.label}
                  <Icon name="chevron-down" size={16} class="nav__chevron" />
                </button>
                <div class="nav__dropdown" id={`nav-menu-${i}`}>
                  <ul role="list">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={url(child.href)}
                          aria-current={isActive(path, child.href) ? 'page' : undefined}
                        >
                          <span class="nav__dropdown-label">{child.label}</span>
                          {child.description && <span class="nav__dropdown-desc">{child.description}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  class:list={['nav__link', { 'is-active': sectionActive(item) }]}
                  href={url(item.href)}
                  aria-current={isActive(path, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={navCta.href} variant="outline" size="sm" class="site-header__cta">{navCta.label}</Button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" size={26} />
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" inert data-mobile-menu>
  <div class="mobile-menu__top container">
    <a class="brand" href={url('/')} aria-label={`${fullName} home`}>
      <img src={url('/brand/qcon-logo-white.png')} alt="" width="362" height="193" />
    </a>
    <button class="menu-toggle" type="button" data-menu-close>
      <Icon name="close" size={26} />
      <span class="visually-hidden">Close menu</span>
    </button>
  </div>

  <nav class="mobile-menu__nav container" aria-label="Main">
    <ul role="list">
      {
        mainNav.map((item) =>
          item.children ? (
            <li>
              <details open={sectionActive(item)}>
                <summary class:list={{ 'is-active': sectionActive(item) }}>
                  {item.label}
                  <Icon name="chevron-down" size={20} class="mobile-menu__chevron" />
                </summary>
                <ul role="list">
                  {item.children.map((child) => (
                    <li>
                      <a href={url(child.href)} aria-current={isActive(path, child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                class:list={['mobile-menu__link', { 'is-active': sectionActive(item) }]}
                href={url(item.href)}
                aria-current={isActive(path, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>

  <div class="mobile-menu__footer container">
    <Button href={navCta.href} size="lg" block icon="arrow-right">Register now</Button>
    <p class="mobile-menu__meta">
      <Icon name="calendar" size={16} />
      {site.event.dateLabel} · {site.venue.name}
    </p>
    <a class="mobile-menu__meta" href={`mailto:${site.contact.email}`}>
      <Icon name="mail" size={16} />
      {site.contact.email}
    </a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: rgb(20 20 22 / 0.94);
    border-bottom-color: var(--line-soft);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 100%;
  }

  .brand {
    display: block;
    flex: none;
    border-radius: var(--radius-xs);
  }

  .brand img {
    width: auto;
    height: 46px;
  }

  /* ---------- Desktop nav ---------- */

  .nav {
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.55rem 0.85rem;
    border: 0;
    border-radius: var(--radius-xs);
    background: none;
    color: var(--ink-100);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast);
  }

  .nav__link:hover,
  .nav__link.is-active,
  .nav__link[aria-current='page'] {
    color: var(--accent-soft);
  }

  .nav__link :global(.nav__chevron) {
    opacity: 0.7;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    min-width: 290px;
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgb(27 28 30 / 0.97);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-pop);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  /* Hover bridge so the menu doesn't close in the gap. */
  .nav__dropdown::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }

  .nav__dropdown ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__dropdown a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--dur-fast);
  }

  .nav__dropdown a:hover,
  .nav__dropdown a[aria-current='page'] {
    background: var(--surface-hover);
  }

  .nav__dropdown-label {
    display: block;
    color: var(--text);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .nav__dropdown a[aria-current='page'] .nav__dropdown-label {
    color: var(--accent-soft);
  }

  .nav__dropdown-desc {
    display: block;
    margin-top: 2px;
    color: var(--text-subtle);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  @media (hover: hover) {
    .nav__item--menu:hover .nav__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }

    .nav__item--menu:hover :global(.nav__chevron) {
      transform: rotate(180deg);
    }
  }

  .nav__item--menu:focus-within .nav__dropdown,
  .nav__item--menu[data-open] .nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .nav__item--menu[data-open] :global(.nav__chevron) {
    transform: rotate(180deg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: #fff;
    cursor: pointer;
  }

  @media (max-width: 1079px) {
    .nav {
      display: none;
    }

    .site-header__actions {
      margin-left: auto;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 479px) {
    .site-header :global(.site-header__cta) {
      display: none;
    }

    .brand img {
      height: 40px;
    }
  }

  /* ---------- Mobile menu ---------- */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background:
      radial-gradient(90% 50% at 100% 0%, rgb(57 148 200 / 0.14), transparent 70%),
      radial-gradient(70% 40% at 0% 100%, rgb(190 74 74 / 0.12), transparent 70%),
      var(--bg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }

  .mobile-menu__nav {
    flex: 1;
    padding-block: var(--space-5);
  }

  .mobile-menu__nav > ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu__nav > ul > li {
    border-bottom: 1px solid var(--line-soft);
  }

  .mobile-menu__link,
  .mobile-menu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__link.is-active,
  .mobile-menu summary.is-active {
    color: var(--accent-soft);
  }

  .mobile-menu :global(.mobile-menu__chevron) {
    color: var(--text-subtle);
    transition: transform var(--dur) var(--ease-out);
  }

  .mobile-menu details[open] :global(.mobile-menu__chevron) {
    transform: rotate(180deg);
  }

  .mobile-menu details ul {
    margin: 0 0 var(--space-4);
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .mobile-menu details a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .mobile-menu details a[aria-current='page'] {
    color: var(--accent-soft);
  }

  .mobile-menu__footer {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-7);
  }

  .mobile-menu__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Solid header once the page scrolls.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Desktop dropdowns: click/keyboard toggle (hover is handled in CSS).
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const closeAll = (except?: HTMLElement) =>
    dropdowns.forEach((d) => {
      if (d === except) return;
      d.removeAttribute('data-open');
      d.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });

  dropdowns.forEach((dd) => {
    const btn = dd.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !dd.hasAttribute('data-open');
      closeAll(dd);
      dd.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) closeAll();
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-dropdown]')) closeAll();
  });

  // Mobile menu.
  const setMenu = (open: boolean) => {
    if (!menu) return;
    menu.classList.toggle('is-open', open);
    menu.inert = !open;
    document.body.classList.toggle('menu-open', open);
    openBtn?.setAttribute('aria-expanded', String(open));
    (open ? closeBtn : openBtn)?.focus();
  };

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu?.classList.contains('is-open')) setMenu(false);
    closeAll();
  });

  window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => {
    if (e.matches && menu?.classList.contains('is-open')) setMenu(false);
  });
</script>
