---
/**
 * Home hero — Q-Con's full-screen dark hero (title, "Student Conference", tagline, particle wave)
 * with IECON's "save the date" facts and action row, plus a live countdown.
 */
import ParticleField from '../ui/ParticleField.astro';
import Button from '../ui/Button.astro';
import Countdown from '../ui/Countdown.astro';
import Icon from '../ui/Icon.astro';
import { site, dateText } from '../../config/site';
---

<section class="hero">
  <ParticleField
    variant="wave"
    tone="blue"
    horizon={0.56}
    fps={30}
    mask="linear-gradient(105deg, rgb(0 0 0 / 0.15) 0%, rgb(0 0 0 / 0.55) 35%, #000 65%)"
  />
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <ul class="hero__facts" role="list">
      <li><Icon name="calendar" size={18} /> {dateText}</li>
      <li><Icon name="pin" size={18} /> {site.venue.name}, {site.venue.city}</li>
    </ul>

    <h1 class="hero__title">
      <span class="hero__name">{site.name} {site.edition}</span>
      <span class="hero__kind">{site.kind}</span>
    </h1>
    <p class="hero__tagline">{site.tagline}</p>

    <div class="hero__actions">
      <Button href="/registration/" size="lg" icon="arrow-right">Register Now</Button>
      <Button href="/submissions/" size="lg" variant="outline">Submit Your Work</Button>
    </div>

    <Countdown class="hero__countdown" />
  </div>

</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(640px, 100svh);
    /* Bottom: the announcements card overlaps the last --space-9 (see Announcements), plus a gap. */
    padding-block: calc(var(--header-h) + var(--space-7)) calc(var(--space-9) + var(--space-7));
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 80% 75%, rgb(57 148 200 / 0.12), transparent 70%),
      radial-gradient(50% 40% at 10% 10%, rgb(80 0 0 / 0.25), transparent 70%),
      var(--bg);
  }

  .hero__glow {
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(0deg, var(--bg), transparent);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.45em 1em;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgb(20 20 22 / 0.75);
    color: var(--text-body);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .hero__facts :global(svg) {
    color: var(--accent-soft);
  }

  .hero__title {
    display: grid;
    gap: 0.05em;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .hero__name {
    font-size: min(var(--text-hero), 11.2vw);
    white-space: nowrap;
    font-weight: 400;
    line-height: 1.02;
  }

  .hero__kind {
    font-size: calc(min(var(--text-hero), 11.2vw) * 0.72);
    font-weight: 200;
    line-height: 1.1;
    color: var(--ink-100);
  }

  .hero__tagline {
    margin-top: var(--space-5);
    color: #fff;
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .hero :global(.hero__countdown) {
    margin-top: var(--space-7);
  }


  /* Phones size the hero to its content: full height would leave half the screen empty above the title. */
  @media (max-width: 640px) {
    .hero {
      min-height: 0;
      /* The card overlaps less on phones (--space-7). */
      padding-bottom: calc(var(--space-7) * 2);
    }

    .hero__actions > :global(*) {
      flex: 1 1 100%;
    }
  }
</style>
