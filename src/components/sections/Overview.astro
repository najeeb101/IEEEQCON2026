---
/** Q-Con "Bringing together the worlds of engineering and innovation" panel with the four staggered feature cards. */
import FeatureCard from '../ui/FeatureCard.astro';
import Button from '../ui/Button.astro';
import ParticleField from '../ui/ParticleField.astro';
import { highlights } from '../../data/program';
---

<section class="section overview" id="overview" aria-labelledby="overview-title">
  <div class="container overview__grid">
    <div class="overview__panel" data-reveal>
      <ParticleField variant="wave" tone="blue" intensity={0.55} horizon={0.72} mask="linear-gradient(0deg, #000 10%, transparent 70%)" />
      <div class="overview__text">
        <span class="eyebrow">About the conference</span>
        <h2 id="overview-title">Bringing together the worlds of engineering and innovation in Qatar</h2>
        <p class="lead">
          This conference brings together students and professionals to present research, showcase engineering
          prototypes, and connect with leaders in academia and industry. It’s a platform for discovery, creativity,
          and impactful ideas, all under one national event.
        </p>
        <div class="overview__actions">
          <Button href="/program/schedule/" icon="arrow-right">Conference Schedule</Button>
          <Button href="/about/" variant="ghost" icon="arrow-right">About Q-Con</Button>
        </div>
      </div>
    </div>

    <div class="overview__cards">
      {
        highlights.map((h, i) => (
          <FeatureCard title={h.title} icon={h.icon} index={i}>
            {h.body}
          </FeatureCard>
        ))
      }
    </div>
  </div>
</section>

<style>
  .overview__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-6);
    align-items: center;
  }

  .overview__panel {
    position: relative;
    overflow: hidden;
    min-height: 100%;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .overview__text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    height: 100%;
    justify-content: center;
    padding: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .overview__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-2);
  }

  .overview__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* Q-Con's staggered card columns */
  @media (min-width: 1081px) {
    .overview__cards > :global(:nth-child(even)) {
      top: var(--space-7);
    }

    .overview {
      padding-bottom: calc(var(--section-y) + var(--space-7));
    }
  }

  @media (max-width: 1080px) {
    .overview__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .overview__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
