---
/** Q-Con "A Full Day of Innovation. One Unifying Experience." split panel, with key moments from the schedule. */
import SplitPanel from '../ui/SplitPanel.astro';
import Button from '../ui/Button.astro';
import { schedule, scheduleStatus } from '../../data/program';
import { site, fullName, dateText } from '../../config/site';
import { formatTime } from '../../lib/format';
import { url } from '../../lib/url';

const moments = schedule.filter((s) => ['arrival', 'keynote', 'block', 'panel', 'ceremony'].includes(s.kind) && s.title !== 'Opening Ceremony');
---

<section class="section" aria-labelledby="flow-title">
  <div class="container">
    <SplitPanel variant="rings" tone="maroon" columns="1fr 1fr">
      <Fragment slot="visual">
        <p class="flow__statement">A Full Day of Innovation.<br />One Unifying Experience.</p>
        <img class="flow__logo" src={url('/brand/qcon-logo-white.png')} alt={fullName} width="240" height="128" loading="lazy" />
      </Fragment>

      <h2 id="flow-title" class="visually-hidden">The day at a glance</h2>
      <p class="lead">
        <span class="highlight">{fullName}</span> brings students, researchers, and industry leaders together for a full-day
        event packed with keynotes, technical talks, posters, prototypes, and hands-on networking.
      </p>

      <ol class="flow__moments" role="list">
        {
          moments.map((m) => (
            <li>
              <time>{formatTime(m.start)}</time>
              <span>{m.title}</span>
            </li>
          ))
        }
      </ol>

      <p class="muted">
        With parallel technical tracks, interactive demos, poster discussions, and a competitive prototype showcase, the
        conference creates opportunities for students to learn from one another and gain feedback from faculty and industry
        reviewers.
      </p>
      <div class="flow__actions">
        <Button href="/program/schedule/" icon="arrow-right">Full schedule</Button>
        <span class="flow__when">
          {[dateText, site.event.timeLabel, scheduleStatus === 'tentative' && 'Tentative program'].filter(Boolean).join(' · ')}
        </span>
      </div>
    </SplitPanel>
  </div>
</section>

<style>
  .flow__statement {
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.3;
    text-shadow: 0 4px 24px rgb(0 0 0 / 0.8);
  }

  .flow__logo {
    width: clamp(160px, 16vw, 240px);
  }

  .flow__moments {
    display: grid;
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .flow__moments li {
    position: relative;
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
  }

  .flow__moments li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--maroon-400);
    transform: translateY(-50%);
  }

  .flow__moments time {
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }

  .flow__moments span {
    color: var(--text);
    font-weight: 500;
  }

  .flow__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .flow__when {
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }
</style>
