---
/** Important dates — IECON's two-column block (visual + list) with the Q-Con timeline. */
import SectionHeading from '../ui/SectionHeading.astro';
import DateTimeline from '../ui/DateTimeline.astro';
import Button from '../ui/Button.astro';
import ParticleField from '../ui/ParticleField.astro';
import { importantDates } from '../../data/submissions';
---

<section class="section section--deep" aria-labelledby="dates-title">
  <div class="container dates">
    <div class="dates__intro">
      <SectionHeading
        id="dates-title"
        eyebrow="Mark your calendar"
        title="Important Dates"
        lead="Abstracts, posters and prototypes follow their own deadlines. Everything comes together on conference day."
      />
      <div class="dates__actions" data-reveal>
        <Button href="/submissions/" icon="arrow-right">Call for Submissions</Button>
      </div>
      <div class="dates__visual" aria-hidden="true">
        <ParticleField variant="sphere" tone="cyan" intensity={0.9} />
      </div>
    </div>
    <DateTimeline dates={importantDates} />
  </div>
</section>

<style>
  .dates {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-8);
    align-items: start;
  }

  .dates__intro {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }

  .dates__intro :global(.heading) {
    margin-bottom: var(--space-5);
  }

  .dates__visual {
    position: relative;
    width: min(340px, 100%);
    aspect-ratio: 1;
    margin-top: var(--space-6);
  }

  @media (max-width: 960px) {
    .dates {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .dates__intro {
      position: static;
    }

    .dates__visual {
      display: none;
    }
  }
</style>
