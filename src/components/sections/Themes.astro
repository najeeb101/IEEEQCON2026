---
/** Conference themes — Q-Con's light "paper" band from the About page, the one light section in the theme. */
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { themes } from '../../data/program';
---

<section class="section section--paper themes" aria-labelledby="themes-title">
  <div class="container">
    <SectionHeading
      id="themes-title"
      eyebrow="What we focus on"
      title="Conference Themes"
      lead="IEEE Q-Con focuses on engineering innovations that address real-world challenges. These themes guide the talks, posters, and prototype submissions."
      align="center"
    />
    <ul class="themes__grid" role="list" data-reveal>
      {
        themes.map((t) => (
          <li class="theme">
            <span class="theme__icon">
              <Icon name={t.icon} size={30} />
            </span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .themes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6);
    border: 1px solid #e1e5ea;
    border-radius: var(--radius-md);
    background: #fff;
    text-align: center;
    transition:
      translate var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .theme:hover {
    translate: 0 -4px;
    box-shadow: 0 24px 48px -28px rgb(0 96 152 / 0.45);
  }

  .theme__icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--brand-blue), var(--brand-maroon));
    color: #fff;
  }

  .theme h3 {
    color: var(--ink-900);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .theme p {
    color: #5b616b;
  }

  @media (max-width: 860px) {
    .themes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
